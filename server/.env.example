# Firebase Admin SDK defaults to ADC; set the project ID locally and authenticate with Google ADC.
FIREBASE_PROJECT_ID=
# Select "service-account" only for an already-approved deployment credential source.
FIREBASE_ADMIN_CREDENTIAL_MODE=adc
# Optional only when FIREBASE_ADMIN_CREDENTIAL_MODE=service-account; backend secrets only.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
