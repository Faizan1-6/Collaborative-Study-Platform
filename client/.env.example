
# Vite proxies API and Socket.IO traffic to the backend during development.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5000

# Production backend HTTPS origin. Replace with your deployed backend URL.
# VITE_ values are exposed to the browser; never put private secrets here.
VITE_API_BASE_URL=https://api.example.com

# Firebase web app configuration (public client configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
